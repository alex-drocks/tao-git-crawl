# Copy this file to .env and fill in your token locally.
# Keep .env out of git; it is ignored by .gitignore.
GITHUB_TOKEN=<paste-token-here>

# The API is bound to same-server localhost by default.
# Set TAO_API_BIND_HOST=0.0.0.0 only when you intentionally want Docker to
# publish the API on all host interfaces.
# TAO_API_BIND_HOST=127.0.0.1
# TAO_API_PORT=8080

# Generous per-client guardrail for direct exposure. Set requests to 0 to
# disable, or rely on your reverse proxy for stricter public API limits.
# TAO_API_RATE_LIMIT_REQUESTS=1200
# TAO_API_RATE_LIMIT_WINDOW_SECONDS=60
